NODE_ENV=development
PORT=4000
API_PREFIX=/api
# Local CockroachDB runs without TLS only for development. Production Cockroach
# clusters must use their certificate-protected URL (typically sslmode=verify-full).
DATABASE_URL="postgresql://root@127.0.0.1:26257/aora?sslmode=disable"
REDIS_URL="redis://localhost:6380"

SESSION_SECRET="change-me-super-secret-32chars-min"
JWT_SECRET="change-me-jwt-secret-32chars-min"
JWT_EXPIRES_IN="7d"
COOKIE_DOMAIN=

# Bachs uses sk_sandbox_* or sk_live_* keys. Register /api/webhooks/bachs
# and subscribe to collection.succeeded and collection.failed.
BACHS_API_KEY="sk_sandbox_xxx"
BACHS_WEBHOOK_SECRET="whsec_xxx"
BACHS_API_URL=""
CLIENT_URL="http://localhost:3000"
EMAIL_DELIVERY_WEBHOOK_URL=""
EMAIL_DELIVERY_WEBHOOK_TOKEN=""

MXROUTE_SERVER="mx1.mxroute.com"
MXROUTE_USERNAME="reseller_user"
MXROUTE_API_KEY="mxroute_api_key_xxx"
MXROUTE_BASE_URL="https://api.mxroute.com/v1"

CLOUDFLARE_API_TOKEN="cf_token_xxx"
CLOUDFLARE_ACCOUNT_ID="cf_account_id"

CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
LOG_LEVEL="info"

# Grace period & thresholds
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
USAGE_WARNING_THRESHOLD=70
USAGE_CRITICAL_THRESHOLD=90

# Rate limiting (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
